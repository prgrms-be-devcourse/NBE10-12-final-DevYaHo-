# Template for required environment variables.
# Copy to .env.local for local dev and fill in real values (never commit .env.local).
# `./gradlew bootRun` picks up .env.local automatically (see build.gradle.kts).
# In production, these same keys must be injected via the deploy environment (not this file).

DB_HOST=
DB_PORT=
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

REDIS_HOST=
REDIS_PORT=

MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

OAUTH_SUCCESS_REDIRECT_URI=
OAUTH_FAILURE_REDIRECT_URI=

# Local-only convenience: auto-creates an ADMIN member on startup if it doesn't exist yet.
# Leave ADMIN_SEED_ENABLED unset (or false) in every non-local environment.
ADMIN_SEED_ENABLED=
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# Local-only convenience: (re)creates a small set of demo group buys (owned by a dedicated
# seed-producer account) on every startup, replacing whatever it seeded last time.
# Leave unset (or false) in every non-local environment.
GROUPBUY_SEED_ENABLED=

JWT_SECRET=
JWT_ACCESS_EXPIRATION_MS=
JWT_REFRESH_EXPIRATION_MS=
JWT_REFRESH_TOKEN_GRACE_SECONDS=

CORS_ALLOWED_ORIGINS=

# 토스페이먼츠 (테스트 키). 클라이언트 키는 프런트 .env.local에 둔다
TOSS_BASE_URL=
TOSS_SECRET_KEY=

# 빌링키 암복호화 마스터 키 - Base64 인코딩된 32바이트 랜덤값 (미설정 시 로컬용 자리표시자가 쓰인다)
# 생성 예: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BILLING_KEY_MASTER_KEY=
